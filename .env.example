# ─── Server ───────
NODE_ENV=development
PORT=5000
TRUST_PROXY=false
API_DOCS_ENABLED=true
LOCAL_STORAGE_DIR=/tmp/recruitai-storage
STORAGE_PROVIDER=local
# For Cloudinary persistent storage:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# For STORAGE_PROVIDER=s3 in production:
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ─── Billing Provider ─────
# manual keeps local/free-first upgrades. stripe enables real checkout + webhook.
BILLING_PROVIDER=manual
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_ID=
# STRIPE_ENTERPRISE_PRICE_ID=

# ─── Malware Scanner ─────
MALWARE_SCAN_PROVIDER=local
# For MALWARE_SCAN_PROVIDER=http:
# MALWARE_SCAN_URL=

# ─── Auth (JWT) ───
JWT_SECRET=change_this_to_a_long_random_secret

# ─── MongoDB ──────
MONGODB_URI=mongodb://localhost:27017/recruiting

# ─── Redis ────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_SOCKET=/tmp/recruitai-redis.sock # Docker sets this automatically for bundled Redis
# REDIS_PASSWORD=your_redis_password   # uncomment if using Redis AUTH
# Managed Redis/Key Value providers can be configured with one URL instead.
# REDIS_URL=rediss://default:password@host:port
# true is convenient for `pnpm dev` and single-service deployments such as Render Free.
# Docker Compose overrides this to false because it starts a dedicated worker service.
EMBEDDED_WORKERS=true

# ─── AI Provider ─────
# Free-first by default. Leave ACTIVE_AI_PROVIDER empty to auto-select:
# Groq (free) -> Gemini free tier -> OpenAI paid -> local rule-based fallback.
# Optional override: 'groq' | 'gemini' | 'openai'
ACTIVE_AI_PROVIDER=

# ─── AI: OpenAI (optional paid upgrade) ─────
OPENAI_API_KEY=

# ─── AI: Google Gemini (free tier available) ───────────
GEMINI_API_KEY=

# ─── AI: Groq (free tier, recommended first key) ───────────
GROQ_API_KEY=

# ─── Sourcing Provider ─────
# Options: 'serper' | 'puppeteer' | 'mock' | 'duckduckgo'
SOURCING_PROVIDER=mock
SERPER_API_KEY=your_serper_api_key

# ─── Frontend ─────
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173
VITE_API_URL=http://localhost:5000
# VITE_QUERY_DEVTOOLS=false

# ─── Google Sign-In ─────
# Use the same OAuth 2.0 Web client ID for both values.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# The Google button appears automatically when VITE_GOOGLE_CLIENT_ID is set.

# ─── Email and monitoring ─────
EMAIL_DELIVERY_MODE=preview
# SMTP is only required when EMAIL_DELIVERY_MODE=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
# ERROR_MONITOR_WEBHOOK=https://monitoring.example.com/webhook
# Optional bearer token required by production metrics scrapers.
# Production requires a random value of at least 24 characters.
# METRICS_TOKEN=
# Required in production when SMTP delivery is enabled; minimum 24 characters.
# EMAIL_WEBHOOK_SECRET=

# ─── Seed and smoke-test helpers ─────
# Production seeding is blocked unless explicitly allowed.
# ALLOW_PRODUCTION_SEED=false
# SEED_USER_EMAIL=demo@recruitai.local
# SEED_USER_PASSWORD=Demo1234!
# API_BASE_URL=http://localhost:5000
# SMOKE_AUTO_START_API=false
