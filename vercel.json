{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "pnpm --filter @recruiting/web build",
    "outputDirectory": "apps/web/dist",
    "installCommand": "pnpm install --frozen-lockfile",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
